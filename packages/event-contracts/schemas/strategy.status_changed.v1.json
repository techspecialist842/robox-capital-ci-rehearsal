{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://robox-capital.internal/events/strategy.status_changed.v1.json",
  "title": "strategy.status_changed",
  "description": "Cambio en el ciclo de vida de una estrategia. Suspender o archivar detiene decisiones con dinero de por medio.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "eventType": {
      "const": "strategy.status_changed"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "enum": [
        "api-gateway",
        "quant-service"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "strategyId",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "strategyId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "suspended",
            "archived"
          ]
        }
      }
    }
  }
}
