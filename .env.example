# --- PostgreSQL (ADR-003) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=robox
POSTGRES_USER=robox
POSTGRES_PASSWORD=robox_dev_only

# --- Redis (ADR-003, solo sesion/cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth / JWT (esqueleto de desarrollo, NO usar en produccion) ---
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=15m
MFA_ISSUER=roboXCapital

# --- Bus de eventos (ADR-002) ---
# "memory": adaptador en un unico proceso, solo para desarrollo local.
# "sns-sqs": adaptador real. Exige EVENT_BUS_TOPIC_ARN o el servicio no arranca.
# La semantica que deben cumplir productores y consumidores (idempotencia, orden,
# reintentos y DLQ) esta en packages/event-contracts/SEMANTICA.md.
EVENT_BUS_DRIVER=memory
# EVENT_BUS_TOPIC_ARN y EVENT_BUS_QUEUE_URL son salidas de la pila Events de infra/cdk.
# EVENT_BUS_TOPIC_ARN=
# EVENT_BUS_QUEUE_URL=
# Solo para pruebas contra LocalStack; vacio en AWS real.
# AWS_ENDPOINT_URL=http://localhost:4566

# --- API Gateway ---
API_GATEWAY_PORT=3000

# --- Observabilidad (ADR-009) ---
# El servicio emite una linea JSON por evento a stdout; en ECS/Fargate el driver de
# logs la entrega a CloudWatch sin agente adicional.
SERVICE_NAME=api-gateway
ENVIRONMENT=local
LOG_LEVEL=log

# --- Gestion de secretos (ADR-008) ---
# "env" SOLO es valido en local/test. En dev, staging y produccion debe ser "aws";
# con cualquier otro valor el servicio falla al arrancar a proposito, para que un
# despliegue mal configurado no corra leyendo secretos en texto plano.
SECRETS_PROVIDER=env
AWS_REGION=us-east-1

# --- Quant Service ---
QUANT_SERVICE_PORT=8000

# --- Proveedores externos confirmados (ADR-007) — capa de adaptadores, sin credenciales reales aqui ---
BROKER_PROVIDER=interactive_brokers
BROKER_ADAPTER_MODE=paper
MARKET_DATA_PROVIDER=interactive_brokers
AI_PROVIDER=openai
# AI_PROVIDER_API_KEY debe vivir en AWS Secrets Manager (ADR-008), nunca aqui en produccion.
