# --- PostgreSQL (ADR-003) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=robox
POSTGRES_USER=robox
POSTGRES_PASSWORD=robox_dev_only

# --- Redis (ADR-003, solo sesion/cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth / JWT (esqueleto de desarrollo, NO usar en produccion) ---
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=15m
MFA_ISSUER=roboXCapital

# --- Bus de eventos (ADR-002) ---
# En desarrollo local se usa un adaptador en memoria (ver events/event-bus.service.ts).
# En AWS: SNS_TOPIC_ARN / SQS_QUEUE_URL vendran de infra/cdk (ADR-004).
EVENT_BUS_DRIVER=memory

# --- API Gateway ---
API_GATEWAY_PORT=3000

# --- Quant Service ---
QUANT_SERVICE_PORT=8000

# --- Proveedores externos confirmados (ADR-007) — capa de adaptadores, sin credenciales reales aqui ---
BROKER_PROVIDER=interactive_brokers
BROKER_ADAPTER_MODE=paper
MARKET_DATA_PROVIDER=interactive_brokers
AI_PROVIDER=openai
# AI_PROVIDER_API_KEY debe vivir en AWS Secrets Manager (ADR-008), nunca aqui en produccion.
